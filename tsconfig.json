{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "jsx": "react-jsx", "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src", "runner", "web", "scripts", "tests", "*.ts"]
}
